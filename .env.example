# Deployer / keeper wallet. Needs ETH on Robinhood Chain for the launch fee, the seed buy and gas.
PRIVATE_KEY=0x
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# pons v2 stack on Robinhood Chain (chain id 4663). From docs.ponsfamily.com/v2. Re-check before use:
# pons replaces the stack as a whole set, and a token belongs to the stack that launched it.
PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
PONS_HOOK=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044
# Leave empty to read poolManager() from the hook.
POOL_MANAGER=

# Launch terms
LAUNCH_CONFIG_ID=0
CREATOR_TAX_BPS=300
TOKEN_LOGO=ipfs://
TOKEN_DESCRIPTION=A vault on Robinhood Chain. Trading fees buy STILL into the vault. vSTILL just gets worth more. No claim step, no owner.
TOKEN_TWITTER=https://x.com/
TOKEN_WEBSITE=https://

# Harvester bounds
MAX_BUY_WEI=100000000000000000
COOLDOWN_SEC=300

# Seed: ETH spent on the opening curve buy, and how much of the STILL received is parked at 0x...dEaD
SEED_ETH_WEI=50000000000000000
SEED_STILL_WEI=1000000000000000000000

# Keeper
HARVESTER=
INTERVAL_SEC=300
SLIPPAGE_BPS=300
